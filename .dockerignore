*.log

# 生成物・非アプリコードのディレクトリ。Dockerfile は src/ config/ formatters/
# plugins/ prompts/ schemas/ alembic.ini pyproject.toml しか COPY しないため、
# ビルドコンテキストに含めてもイメージには載らないが、転送量を抑えるために除外する。
data/
monitoring/
streamlit_app/
web/
benchmarks/

# 生成済みカバレッジベースライン (6.7 MB の成果物。差分ツールの入力であってソースではない)
cov_baseline.json

# 証明書・秘密鍵はイメージに絶対に載せない
*.pem
*.key
credentials.enc

# 重要: ローカルの実シークレットをイメージ層に焼き込まない。
# `COPY . .` を使うビルド（Dockerfile.prod 等）で .env がイメージに含まれてしまうと、
# コンテナ.layers に平文で残り、イメージの diff 経由で漏洩する。
# テンプレート（.env.example 相当）はバージョンを記述するため除外しない。
.env
.env.*
!.env.example
