.git
.gitignore
.gitattributes
.venv
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
coverage/
coverage.json
.mypy_cache/
.ruff_cache/
htmlcov/
output/
artifacts/
tests/
plans/
docs/
scratch/
frontend/
node_modules/
*.db
*.sqlite
