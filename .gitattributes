# ============================================================
# 改行コードの正規化
# ------------------------------------------------------------
# 背景: これまで .gitattributes には `*.sh text eol=lf` しか無く、
# ローカルの core.autocrlf=true と合わせて src/ 配下の .py が 1022/1023 ファイルで
# CRLF のままチェックアウトされ、ruff が W293 (blank-line-with-whitespace) 1455 件、
# W292 (missing-newline-at-end-of-file) 183 件、W291 66 件 = 計 1705 件の
# 「違反」を報告していた。これは実質的なコードの不備ではなく改行コードの設定ミスである。
# 同様に `ruff format --check src` の 738 ファイル失敗の大半も CRLF 由来。
#
# 既存ファイルは automatically re-normalize されないため、
# 以下のコマンドは別途（意図的に）実行する必要がある:
#     git add --renormalize .
#     git commit -m "chore: normalize line endings to LF"
# これを実行するまで、チェックアウト済みファイルは CRLF のままである点に注意。
# ============================================================

# デフォルト: リポジトリ内では LF で保存し、チェックアウトも LF
* text=auto eol=lf

# ソースコード・設定・ドキュメントは明示的に LF
*.py      text eol=lf
*.pyi     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.jsx     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.sh      text eol=lf
*.bash    text eol=lf
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf
Dockerfile text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
.dockerignore text eol=lf

# バイナリは判定対象外にする（text 変換で壊さないため）
