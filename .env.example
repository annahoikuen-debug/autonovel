# ============================================================
# AutoNovel v5.2.1 環境変数設定例
# このファイルを .env にコピーして使用してください
#   cp .env.example .env
# ------------------------------------------------------------
# 必須: [必須] 区画のみ設定すれば起動可能
# オプション: [オプション] 区画は未設定でもコア機能は動作
#
# 重要: ここに無いキーは Settings（src/backend/config.py）に存在しないか、
# extra="ignore" により黙って捨てられます。設定したつもりが読まれない原因是
# 主に「未定義のキー名」でした（例: 旧 LLM_MODEL）。
# キー名を確認するには: grep -E "^\s{4}[A-Z_]+:" src/backend/config.py
#
# 本番運用（APP_ENV=production）では JWT_SECRET_KEY / ALLOWED_API_KEYS /
# CORS_ORIGINS が未設定だと起動を拒否するのが安全です。docker-compose.prod.yml は
# ${VAR:?} 構文でこれらを fail-fast にしています。
# ============================================================

# ------------------------------------------------------------
# [必須] データベース
# ------------------------------------------------------------
# ローカル起動 (SQLite):
DATABASE_URL=sqlite:///storage/autonovel.db
# Docker 起動 (PostgreSQL):
# DATABASE_URL=postgresql://autonovel:autonovel@db:5432/autonovel

# ------------------------------------------------------------
# [必須] アプリケーション基本設定
# ------------------------------------------------------------
# development | testing | production
# production にすると JWT/Allowed API key の検証が有効化される。
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text
# 待ち受けアドレスとポート（Dockerfile は 8200 で EXPOSE している）
HOST=0.0.0.0
PORT=8200

# ------------------------------------------------------------
# [本番必須] 認証・JWT
# ------------------------------------------------------------
# ランダム値を生成するには: openssl rand -hex 32
# 未設定のまま production で動かすと get_jwt_secret_key() がプロセスごとに
# secrets.token_hex(32) を生成し、ワーカー間・再起動間でトークンが無効化される。
#
# 警告: 下の `JWT_SECRET_KEY` の例示値（および `SECRET_KEY` の例示値）は
# **本番では使用できません**。本番設定の検証器は `.env.example` を読み、
# このファイルに書かれているキー値と一致する `JWT_SECRET_KEY` / `SECRET_KEY`
# を拒否します（公開リポジトリに載っている値をそのまま JWT 署名キーにすると
# 管理者トークンを偽造できるため）。本番では `openssl rand -hex 32` で作った
# 値を必ず設定してください。
JWT_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
# リクエストヘッダで許容する API キー（カンマ区切り）。重負荷エンドポイントの保護に使う。
# docker-compose.prod.yml:31 は ${ALLOWED_API_KEYS:?} で fail-fast するため、
# 本番（APP_ENV=production）では必ず 1 つ以上の実値を入れること。
# 例: ALLOWED_API_KEYS=k1xxxxxxxxxxxxxxxx,k2yyyyyyyyyyyyyyyy
ALLOWED_API_KEYS=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
# ローカル開発でのみ true にする。production で true は危険（認証が全面的に無効化される）。
AUTH_DISABLED=false

# ------------------------------------------------------------
# [必須] CORS
# ------------------------------------------------------------
# フロントエンドの実Origin をカンマ区切りで指定する。
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_ALLOW_HEADERS=*
# フロントエンドの URL（メール/通知リンク生成などに使用）
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------
# [オプション] Redis / Huey タスクキュー
# ------------------------------------------------------------
# 未設定時はインメモリフォールバック
REDIS_URL=redis://localhost:6379/0
# sqlite | redis（Settings.HUEY_BACKEND の Literal と一致させること。
# "memory" を書くと起動時に ValidationError で落ちる）
HUEY_BACKEND=sqlite
HUEY_SQLITE_PATH=storage/huey.db
# docker-compose.prod.yml:40,165 は ${REDIS_PASSWORD:?} で fail-fast し、
# Redis を `--requirepass` で保護する（backend/worker は
# redis://:${REDIS_PASSWORD}@redis:6379/0 の形式で接続する）。
# 未設定のまま本番を起動すると "REDIS_PASSWORD is required" で compose 自体が失敗する。
# 本番では必ずランダム値を設定すること: openssl rand -hex 16
REDIS_PASSWORD=

# ------------------------------------------------------------
# [オプション] LLM プロバイダ
# ------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
# OPENROUTER_ROUTING は dict[str, str] 型。未設定なら config.py の既定マップ
# (planning/plot_expansion/audit/marketing -> gemini, writing/climax -> claude) が使われる。
# `false` のような空でない文字列を書くと Settings の型検証で起動が失敗する。
# タスク別モデルを上書きする場合のみ以下のように JSON 形式で書くこと:
# OPENROUTER_ROUTING={"planning":"google/gemini-2.0-flash","writing":"anthropic/claude-3-5-sonnet-20241022"}
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ------------------------------------------------------------
# [オプション] RAG / ベクトル検索
# ------------------------------------------------------------
AUTONOVEL_RAG_MODE=memory
RAG_FALLBACK_MODE=memory
RAG_BATCH_SIZE=32
RAG_REFLECTION_ENABLED=false
ENABLE_GRAPHRAG=false
REQUIRE_CHROMA=false
REQUIRE_PG=false
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_DB_PATH=storage/chroma
EMBEDDING_MODEL=
EMBEDDING_MODEL_FALLBACK=
# RERANKER_BACKEND は "none" | "simple" | "cross_encoder" のいずれか。
# 未設定時は "none" を使うため、このキーは未設定のままにするのが安全。
# 空文字を書くと Settings の型検証で起動が失敗する。
# RERANKER_BACKEND=none
RERANKER_MODEL=
AGE_GRAPH_NAME=

# ------------------------------------------------------------
# [オプション] 画像生成
# ------------------------------------------------------------
IMAGE_PROVIDER=mock
DALL_E_API_KEY=
COMFYUI_URL=
SD_WEBUI_URL=

# ------------------------------------------------------------
# [オプション] 音声 (VOICEVOX)
# ------------------------------------------------------------
# 未設定 / サーバー不在時はグレースフルにスキップされる。
VOICEVOX_URL=http://localhost:50021
VOICEVOX_DEFAULT_SPEAKER_ID=46
VOICEVOX_TIMEOUT_SECONDS=5

# ------------------------------------------------------------
# [オプション] 課金 (Stripe)
# ------------------------------------------------------------
# 未設定なら課金機能は無効。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe 署名検証を完全に省略してよい環境向けのオプトインフラグ（既定 false）。
#
# `src/backend/routers/billing_webhook.py` は、次の両方が揃うときだけ
# 署名検証をスキップする:
#   1. `STRIPE_WEBHOOK_SECRET` が空である
#   2. かつ `ALLOW_UNSIGNED_WEBHOOKS` が明示的に true である
#
# 以前は 1 だけで署名検証を省略していたため、`APP_ENV` の既定が
# "development" である以上、ほぼすべての環境で署名検証なしで
# webhook を偽装しクレジットを付与できる状態になっていた。
# ローカル検証以外では絶対に true にしないこと。
# 本番（APP_ENV=production）では `STRIPE_WEBHOOK_SECRET` の設定が必須。
ALLOW_UNSIGNED_WEBHOOKS=false

# ------------------------------------------------------------
# [オプション] 監査 / 強化機能フラグ
# ------------------------------------------------------------
MULTI_LAYER_AUDIT_ENABLED=false
BLIND_REVIEW_ENABLED=false
ENRICHMENT_ENABLED=false
PROSE_REFINER_ENABLED=false
PROSE_REFINER_MODEL=
PROSE_REFINER_STYLE=

# ------------------------------------------------------------
# [オプション] ヘルスチェック
# ------------------------------------------------------------
HEALTH_CHECK_LLM_PROBE=false
HEALTH_CHECK_TIMEOUT_SECONDS=5

# ------------------------------------------------------------
# [オプション] 機能フラグ (プラグイン疎結合化・Step 15-22)
# ------------------------------------------------------------
# マルチメディアプラグイン (画像・音声)。未設定 / false でコアから分離。
ENABLE_MULTIMEDIA=false
# 外部投稿プラグイン。未設定 / false でコアから分離。
ENABLE_SOCIAL_POSTING=false
ENABLE_AUDIO_SYNTH=false
MULTIMEDIA_OUTPUT_DIR=output/multimedia

# ------------------------------------------------------------
# [オプション] Docker Compose Database Credentials
# ------------------------------------------------------------
# 開発用 (docker-compose.yml)。本番 (docker-compose.prod.yml) では
# POSTGRES_PASSWORD が ${POSTGRES_PASSWORD:?} で必須になるため、
# 本番デプロイ時は別途ランダム値を設定すること。
# 生成例: openssl rand -hex 16
POSTGRES_USER=autonovel
POSTGRES_PASSWORD=autonovel_dev_password_change_me
POSTGRES_DB=autonovel
